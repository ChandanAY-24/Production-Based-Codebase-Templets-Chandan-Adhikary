# Server Runtime
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# OmniRoute Proxy
OMNIROUTE_PORT=8088
DEFAULT_MODEL_TIER=tier2

# Database
DATABASE_URL=sqlite:///./database/app.db

